<% if params[:document_control] == "1" %>
  <% @files = DmsfFile.where(project_id: @project.id, deleted: DmsfFile::STATUS_ACTIVE)
                      .includes(:dmsf_folder, :dmsf_file_revisions)
                      .order(updated_at: :desc) %>
  <% @filter = params[:filter].presence || "all" %>
  <% @files = @files.select { |file| visible_for_document_control_filter?(file.last_revision, @filter) } %>
  <%= render inline: File.read(
        "/usr/src/redmine/plugins/redmine_aspice_document_control/app/views/aspice_document_control/index.html.erb"
      ), type: :erb %>
<% else %>
  <%= render partial: "dmsf/main", locals: {} %>
<% end %>
