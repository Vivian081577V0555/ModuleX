<% content_for :header_tags do %>
  <%= stylesheet_link_tag "aspice_document_control", plugin: :redmine_aspice_document_control %>
<% end %>

<div class="adc-header">
  <div>
    <h2>Document Control</h2>
    <p>Review and release documents in the same structure used by Document Manager.</p>
  </div>
  <% if User.current.allowed_to?(:submit_aspice_documents, @project) %>
    <%= link_to "Upload document", multi_dmsf_upload_path(id: @project), class: "icon icon-add button-positive" %>
  <% end %>
</div>

<nav class="adc-filters" aria-label="Document views">
  <% [["all", "All"], ["draft", "My drafts"], ["mine", "Waiting for me"], ["approval", "In approval"], ["approved", "Approved"], ["returned", "Returned"]].each do |value, label| %>
    <%= link_to label, project_aspice_document_control_path(project_id: @project.identifier, filter: value), class: (@filter == value ? "selected" : nil) %>
  <% end %>
</nav>

<% render_files = lambda do |files| %>
  <div class="adc-table-wrap">
    <table class="list adc-table">
      <thead><tr><th>Document</th><th>Version</th><th>Status</th><th>Current stage</th><th>Current approver</th><th>Updated</th><th class="buttons">Action</th></tr></thead>
      <tbody>
        <% files.each do |file| %>
          <% revision = file.last_revision %>
          <% status = document_control_status(revision) %>
          <tr>
            <td class="adc-document"><%= link_to(revision&.title.presence || file.name, dmsf_file_path(file)) %><small><%= file.name %></small></td>
            <td><%= revision&.version || "-" %></td>
            <td><span class="adc-status adc-<%= status.parameterize %>"><%= status %></span></td>
            <td><%= document_control_step(revision) %></td>
            <td><%= document_control_approvers(revision) %></td>
            <td><%= format_time(file.updated_at) %></td>
            <td class="buttons adc-actions">
              <% workflow = document_control_workflow %>
              <% if revision && revision.workflow == DmsfWorkflow::STATE_ASSIGNED && User.current.allowed_to?(:submit_aspice_documents, @project) %>
                <%= link_to "Submit", start_dmsf_workflow_path(id: revision.dmsf_workflow_id, dmsf_file_revision_id: revision.id, back_url: project_aspice_document_control_path(project_id: @project.identifier)), class: "button-positive" %>
              <% elsif revision && workflow && status == "Draft" && User.current.allowed_to?(:submit_aspice_documents, @project) %>
                <%= button_to "Assign workflow", assignment_dmsf_workflow_path(workflow, project_id: @project.id, dmsf_file_revision_id: revision.id, back_url: project_aspice_document_control_path(project_id: @project.identifier)), method: :post, params: { commit: l(:button_submit), dmsf_workflow_id: workflow.id }, class: "button-positive" %>
              <% elsif revision && status == "Draft" && User.current.allowed_to?(:submit_aspice_documents, @project) %>
                <span class="adc-muted">Workflow not configured</span>
              <% elsif revision && document_control_actionable?(revision) && User.current.allowed_to?(:approve_aspice_documents, @project) %>
                <% assignment = document_control_assignment(revision) %>
                <%= button_to "Approve", new_action_dmsf_workflow_path(revision.dmsf_workflow_id, project_id: @project.id, dmsf_file_revision_id: revision.id, dmsf_workflow_step_assignment_id: assignment.id, back_url: project_aspice_document_control_path(project_id: @project.identifier)), method: :post, params: { commit: l(:button_submit), step_action: DmsfWorkflowStepAction::ACTION_APPROVE }, class: "button-positive" %>
                <details class="adc-reject"><summary>Return</summary><%= form_tag new_action_dmsf_workflow_path(revision.dmsf_workflow_id, project_id: @project.id, dmsf_file_revision_id: revision.id, dmsf_workflow_step_assignment_id: assignment.id, back_url: project_aspice_document_control_path(project_id: @project.identifier)), method: :post do %><%= hidden_field_tag :commit, l(:button_submit) %><%= hidden_field_tag :step_action, DmsfWorkflowStepAction::ACTION_REJECT %><%= text_field_tag :note, nil, placeholder: "Reason required", required: true %><%= submit_tag "Return", class: "button" %><% end %></details>
              <% elsif status == "Approved" %>
                <%= link_to "Open", dmsf_file_path(file), class: "icon icon-file" %>
              <% else %>
                <span class="adc-muted">-</span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>

<div class="adc-tree">
  <% if @root_files.any? %>
    <details class="adc-folder adc-root-files" open>
      <summary><span class="icon icon-file">Root documents</span><b><%= @root_files.size %></b></summary>
      <% render_files.call(@root_files) %>
    </details>
  <% end %>

  <% @folder_sections.each do |section| %>
    <% section_count = section[:files].size + section[:children].sum { |child| child[:files].size } %>
    <details class="adc-folder adc-level-1" open>
      <summary><span class="icon icon-folder"><%= section[:folder].title %></span><b><%= section_count %></b></summary>
      <% render_files.call(section[:files]) if section[:files].any? %>
      <div class="adc-children">
        <% section[:children].each do |child| %>
          <details class="adc-folder adc-level-2">
            <summary><span class="icon icon-folder"><%= child[:folder].title %></span><b><%= child[:files].size %></b></summary>
            <% render_files.call(child[:files]) %>
          </details>
        <% end %>
      </div>
    </details>
  <% end %>

  <% if @root_files.empty? && @folder_sections.empty? %>
    <p class="nodata">No documents in this view.</p>
  <% end %>
</div>
