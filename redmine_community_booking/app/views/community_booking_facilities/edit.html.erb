<h2><%= l(:label_community_booking_facility_edit) %></h2>

<%= labelled_form_for @facility, url: project_community_booking_facility_path(@project, @facility), method: :put do |f| %>
  <%= render partial: 'form', locals: { f: f } %>
  <%= submit_tag l(:button_save) %>
  <%= link_to l(:button_cancel), project_community_booking_facilities_path(@project, facility_id: @facility.id) %>
<% end %>
