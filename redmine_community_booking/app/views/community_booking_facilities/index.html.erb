<% content_for :header_tags do %>
  <%= stylesheet_link_tag 'community_booking', plugin: 'redmine_community_booking' %>
<% end %>

<div class="contextual">
  <% if User.current.allowed_to?(:manage_community_booking, @project) %>
    <%= link_to l(:label_community_booking_facility_new), new_project_community_booking_facility_path(@project), class: 'icon icon-add' %>
  <% end %>
</div>

<h2><%= l(:label_community_booking) %></h2>

<% if @facilities.empty? %>
  <div class="community-booking-empty">
    <h3><%= l(:label_community_booking_no_facility) %></h3>
    <p><%= l(:text_community_booking_no_facility) %></p>
    <% if User.current.allowed_to?(:manage_community_booking, @project) %>
      <p><%= link_to l(:label_community_booking_facility_new), new_project_community_booking_facility_path(@project), class: 'button' %></p>
    <% end %>
  </div>
<% else %>
  <div class="community-booking-toolbar">
    <%= form_tag project_community_booking_facilities_path(@project), method: :get, class: 'community-booking-filter' do %>
      <label><%= l(:field_start_date) %></label>
      <%= date_field_tag :date, @date, onchange: 'this.form.submit()' %>
    <% end %>

    <% if User.current.allowed_to?(:manage_community_booking, @project) %>
      <div class="community-booking-actions">
        <%= link_to l(:label_community_booking_facility_new), new_project_community_booking_facility_path(@project), class: 'button' %>
      </div>
    <% end %>
  </div>

  <nav class="community-booking-days" aria-label="<%= l(:label_calendar) %>">
    <% (-3..3).each do |offset| %>
      <% day = @date + offset.days %>
      <%= link_to project_community_booking_facilities_path(@project, date: day),
                  class: "community-booking-day #{'is-active' if day == @date}" do %>
        <small><%= I18n.t('date.abbr_day_names')[day.wday] %></small>
        <strong><%= day.day %></strong>
        <span><%= day.strftime('%m/%d') %></span>
      <% end %>
    <% end %>
  </nav>

  <div class="community-booking-facility-cards">
    <% @visible_facilities.each do |facility| %>
      <section class="community-booking-facility-card">
        <div>
          <span><%= l(:label_community_booking_facility) %></span>
          <h3><%= facility.name %></h3>
          <p><%= facility.description.presence || l(:text_community_booking_default_description) %></p>
        </div>
        <div class="community-booking-capacity">
          <small><%= l(:label_community_booking_capacity) %></small>
          <strong><%= l(:label_community_booking_capacity_count, count: facility.capacity) %></strong>
          <span><%= format('%02d:00-%02d:00', facility.opening_hour, facility.closing_hour) %></span>
        </div>
        <% if User.current.allowed_to?(:manage_community_booking, @project) %>
          <%= link_to l(:button_edit), edit_project_community_booking_facility_path(@project, facility), class: 'community-booking-edit-link' %>
        <% end %>
      </section>
    <% end %>
  </div>

  <div class="community-booking-calendar-wrap">
    <table class="community-booking-calendar">
      <thead>
        <tr>
          <th class="community-booking-time-col"><%= l(:label_community_booking_time) %></th>
          <% @visible_facilities.each do |facility| %>
            <th>
              <strong><%= facility.name %></strong>
              <span><%= l(:label_community_booking_capacity_count, count: facility.capacity) %></span>
            </th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <% @hours.each do |hour| %>
          <% starts_at = Time.zone.local(@date.year, @date.month, @date.day, hour) %>
          <tr>
            <th class="community-booking-time-col">
              <strong><%= format('%02d:00', hour) %></strong>
              <span><%= format('%02d:00', hour + 1) %></span>
            </th>
            <% @visible_facilities.each do |facility| %>
              <% open = facility.hours.include?(hour) %>
              <% bookings = @bookings[[facility.id, starts_at]] || [] %>
              <% booked_quantity = bookings.sum(&:quantity) %>
              <% remaining = open ? facility.capacity - booked_quantity : 0 %>
              <td class="<%= open ? (remaining.positive? ? 'is-available' : 'is-full') : 'is-closed' %>">
                <% if open %>
                  <div class="community-booking-cell-status">
                    <em><%= remaining.positive? ? l(:label_community_booking_remaining, count: remaining) : l(:label_community_booking_full) %></em>
                    <span><%= l(:label_community_booking_booked_count, booked: booked_quantity, capacity: facility.capacity) %></span>
                  </div>

                  <div class="community-booking-meter">
                    <span style="width: <%= facility.capacity.zero? ? 0 : ((booked_quantity.to_f / facility.capacity) * 100).round %>%"></span>
                  </div>

                  <% if bookings.any? %>
                    <ul class="community-booking-list">
                      <% bookings.each do |booking| %>
                        <li>
                          <span><%= h(booking.user.name) %> &times; <%= booking.quantity %></span>
                          <% if booking.cancellable_by?(User.current) || User.current.allowed_to?(:manage_community_booking, @project) %>
                            <%= link_to l(:button_cancel),
                                        project_community_booking_facility_community_booking_path(@project, facility, booking),
                                        method: :delete,
                                        data: { confirm: l(:text_are_you_sure) } %>
                          <% end %>
                        </li>
                      <% end %>
                    </ul>
                  <% end %>

                  <% if remaining.positive? && User.current.allowed_to?(:book_community_facilities, @project) %>
                    <%= form_tag project_community_booking_facility_community_bookings_path(@project, facility), method: :post, class: 'community-booking-book-form' do %>
                      <%= hidden_field_tag :date, @date %>
                      <%= hidden_field_tag :hour, hour %>
                      <%= number_field_tag :quantity, 1, min: 1, max: remaining %>
                      <%= submit_tag l(:button_community_booking_book) %>
                    <% end %>
                  <% end %>
                <% else %>
                  <span class="community-booking-closed"><%= l(:label_community_booking_closed) %></span>
                <% end %>
              </td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
